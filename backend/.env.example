DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# For Neon, set DATABASE_URL to the pooled (-pooler) connection string and
# DIRECT_URL to the direct connection string from the Neon dashboard.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=3001
WEB_ORIGIN="http://localhost:5173"

# GeniusPay hosted checkout. Keep all keys on the API server.
GENIUSPAY_MODE="sandbox"
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
# Use the secret returned by GeniusPay when creating the Sandbox webhook.
GENIUSPAY_WEBHOOK_SECRET_SANDBOX=""
# Backward-compatible fallback for existing deployments.
GENIUSPAY_WEBHOOK_SECRET=""
GENIUSPAY_WEBHOOK_URL="https://your-public-test-host.example/api/payments/geniuspay/notify"

# Optional first administrator, created by `npm run prisma:seed`.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
