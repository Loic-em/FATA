{
  "name": "fata-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "start:backend": "npm --prefix backend run start",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "preview": "npm --prefix frontend run preview",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate --",
    "prisma:deploy": "npm --prefix backend run prisma:deploy",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "prisma:validate": "npm --prefix backend run prisma:validate"
  }
}
